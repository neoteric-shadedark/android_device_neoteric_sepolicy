# Custom ROM Hide
allow untrusted_app_all custom_rom_hide_data_file:file { open read getattr };
allow gmscore_app custom_rom_hide_data_file:file { open read getattr };
allow priv_app custom_rom_hide_data_file:file { open read getattr };
allow isolated_app custom_rom_hide_data_file:file { open read getattr };
